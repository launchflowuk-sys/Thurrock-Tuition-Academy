# Copy to .env for local dev; set these as environment variables in Coolify for
# production. Every one of these is read at boot — the API server throws on
# startup if a required value is missing.

# --- Required ---------------------------------------------------------------

# Postgres connection string (lib/db).
DATABASE_URL=postgres://user:password@localhost:5432/tta

# Port the API server listens on. Also the port the Vite dev servers bind to.
PORT=8080

# Base path the frontend is served under. "/" for the normal deployment.
BASE_PATH=/

# express-session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# AES-256-GCM key used to encrypt every credential stored in the settings
# table (SMTP password, Square, PayPal, Stripe). Must decode to exactly 32
# bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: rotating this makes existing stored credentials unreadable. Required
# as soon as any credential is saved through the settings page.
SETTINGS_ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------

# Square webhook signature key, from the Square Developer Dashboard webhook
# subscription. Only needed if Square payments are enabled — without it the
# webhook endpoint returns 503 but the rest of the server runs normally.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Origin used for links inside outbound emails (e.g. the "View in Dashboard"
# button on intake notifications). Default: https://www.thurrocktuitionacademy.co.uk
APP_URL=

# Comma-separated allowlist of extra origins permitted to make credentialed
# API calls, for the Expo/React Native client. Leave empty for web-only
# deployments — the frontend is served same-origin and needs no CORS.
CORS_ORIGINS=

# Set to "false" on every replica beyond the first. The recurring-billing cron
# runs in-process, so N replicas would bill every parent N times.
ENABLE_BILLING_CRON=true

# "production" enables secure session cookies and JSON logging.
NODE_ENV=development

# pino log level: trace | debug | info | warn | error | fatal. Default: info
LOG_LEVEL=info

# Where uploaded files are written. MUST be a persistent mounted volume in
# production or every upload is lost on redeploy. Default: /data/uploads
UPLOAD_DIR=/data/uploads
